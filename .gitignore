/target
# Отдельный каталог для сборки Windows-тулчейном: в WSL нет компилятора C и
# заголовков glibc, поэтому линковка идёт через MSVC. Каталоги нельзя смешивать.
/target-msvc
Cargo.lock.bak

# Рабочие каталоги пользователя — создаются рядом с бинарём, см. docs/pipeline.md
/sources/
/work/
/output/
/config.toml

