/target
# A separate directory for builds with the Windows toolchain: WSL has no C compiler and
# no glibc headers, so linking goes through MSVC. The directories must not be mixed.
/target-msvc
Cargo.lock.bak

# The user's work directories — created next to the binary, see docs/en/pipeline.md
/sources/
/work/
/output/
/config.toml

# Bethesda assets never get into the repository under any circumstances
*.esm
*.esp
*.bsa
*.nif
*.kf
*.dds

# Local release build
/dist/

# Local notes: research, task cards, the plan, in-game checks, reports
/_analisys/
# The local part of the instructions for Claude Code: the machine, the plan, the current state
CLAUDE.local.md

# The built documentation site (zensical build)
/site/
/docs/_generated/

# Local Claude Code state: personal hooks and reminder markers
/.claude/settings.local.json
/.claude/.exe-stale-seen
